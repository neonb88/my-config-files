                if num + 1 not in intervals_hash:
                    intervals_hash[num + 1] = num - 1     
                else:
                    intervals_hash[num + 1] = (num - 1, intervals_hash[num + 1])

                if num - 1 not in intervals_hash:
                    intervals_hash[num - 1] = num + 1
                else:
                    intervals_hash[num - 1] = ( intervals_hash[num - 1], num + 1)
                if longest_consec == 0:
                    longest_consec = 1
            else:
                bounds = intervals_hash[num]
                this_was_a_hole = len(bounds) == 2
                if this_was_a_hole:
                    intervals_hash[bounds[0]] = bounds[1]
                    intervals_hash[bounds[1]] = bounds[0]
                    if bounds[1] - bounds[0] - 1 > longest_consec:
                        longest_consec = bounds[1] - bounds[0]
                else:
                    bound = bounds
                    if bound < num:
                        intervals_hash[bound] = num + 1
                    elif bound > num:
                        intervals_hash[bound] = num - 1
                    if  abs(intervals_hash[bound] - num) - 1 > longest_consec:
                        longest_consec = abs(intervals_hash[bound] - num) - 1      
