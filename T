class Solution:
    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:
        locs1 = {e:i for i,e in enumerate(nums1)}
        locs2 = {e:i for i,e in enumerate(nums2)}
        #ans = [0 for i in range(len(nums1))]
        ans = deque()
        j = 0

        for i, num in enumerate(nums1):
            j   = locs2[num] + 1
            if j == len(nums2):
                ans.appendright(-1)
            else:
                while j < len(nums2) and nums2[j] < num:
                    j += 1
                if j >= len(nums2):
                    ans.appendright(-1)
                else:
                    ans.appendright( nums2[j])
        return list(ans)

